# Development settings. Copy to .env, which stays out of git. A deployment sets
# these in its environment instead, with logins and keys of its own.

# Hoard's two logins on the compose database (docker compose up -d db), which
# its first start makes (apps/hoard/backend/scripts/dev-database.sql).
# The owner runs migrations and owns the tables; the serving login serves.
HOARD_DATABASE_URL=postgresql+psycopg://hoard_owner:hoard_owner@localhost:5236/hoard
HOARD_DATABASE_URL_APP=postgresql+asyncpg://hoard_app:hoard_app@localhost:5236/hoard

# Initiative's API, where it publishes the keys its tokens are checked against.
HOARD_INITIATIVE_API_URL=http://localhost:8000/api/v1

# Where browsers load Hoard's pages: its Vite dev server, which hands /api and
# /v1 to the backend on 8300.
HOARD_APP_ORIGIN=http://localhost:5300

# The Ed25519 key Hoard signs its sessions with, as one line. Make one with:
#   uv run python -c "from seneschal_core.testing import new_key_pem; print(new_key_pem().replace(chr(10), r'\n'))"
HOARD_SESSION_PRIVATE_KEY_PEM=

# Billing's statement key (SPKI PEM). Unset, every entitlement statement is
# refused and Hoard holds no plan.
INITIATIVE_ENTITLEMENT_ISSUER_KEY_PEM=

# Tests: a superuser on the compose database, under which each run makes its own.
TEST_POSTGRES_URL=postgresql://postgres:postgres@localhost:5236/postgres
